    "A file is only moved once the bucket confirms the whole upload, and never deleted outright." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei wird erst verschoben, wenn der Bucket den ganzen Upload bestätigt, und nie endgültig gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo solo se mueve cuando el bucket confirma la subida completa, y nunca se elimina directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier n’est déplacé qu’une fois l’envoi entier confirmé par le bucket, et n’est jamais supprimé définitivement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルはバケットがアップロード全体を確認してから移動され、直接削除されることはありません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo só é movido depois que o bucket confirma o envio completo, e nunca é excluído de vez."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dosya ancak bucket yüklemenin tamamını doğruladıktan sonra taşınır ve asla doğrudan silinmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在存储桶确认完整上传后才会移动文件，且绝不会直接删除。"
          }
        }
      }
    },
    "After upload" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Upload"
          }
        },
        "es" : {
