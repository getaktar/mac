          }
        }
      }
    },
    "No thumbnails are made or downloaded for this destination. History and the bucket view show file icons." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Ziel werden keine Vorschaubilder erstellt oder geladen. Verlauf und Bucket-Ansicht zeigen Dateisymbole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se crean ni se descargan miniaturas para este destino. El historial y la vista del bucket muestran iconos de archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune vignette n’est créée ni téléchargée pour cette destination. L’historique et la vue du bucket affichent des icônes de fichier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada gambar mini yang dibuat atau diunduh untuk tujuan ini. Riwayat dan tampilan bucket menampilkan ikon file."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per questa destinazione non vengono create né scaricate miniature. Cronologia e vista bucket mostrano le icone dei file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この保存先ではサムネイルを作成もダウンロードもしません。履歴とバケット表示にはファイルアイコンが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대상에서는 썸네일을 만들거나 다운로드하지 않습니다. 기록과 버킷 보기에는 파일 아이콘이 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor deze bestemming worden geen miniaturen aangemaakt of gedownload. De geschiedenis en de bucketweergave tonen bestandssymbolen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dla tego miejsca docelowego miniatury nie są tworzone ani pobierane. Historia i widok bucketu pokazują ikony plików."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma miniatura é criada ou baixada para este destino. O histórico e a visualização do bucket mostram ícones de arquivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для этого места назначения миниатюры не создаются и не скачиваются. В истории и при просмотре бакета показываются значки файлов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hedef için küçük resim oluşturulmaz ve indirilmez. Geçmiş ve bucket görünümü dosya simgelerini gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для цієї цілі мініатюри не створюються й не завантажуються. В Історії та перегляді бакета показуються значки файлів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không tạo hoặc tải xuống hình thu nhỏ cho đích này. Lịch sử và chế độ xem bucket sẽ hiển thị biểu tượng tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此目标不会创建或下载缩略图。历史记录和存储桶视图将显示文件图标。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此目的地不會製作或下載縮圖。歷史記錄和儲存貯體檢視會顯示檔案圖像。"
          }
        }
      }
    },
    "Not an extension: %@. Use letters and digits only, such as dmg or mp4." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Endung: %@. Nur Buchstaben und Ziffern, etwa dmg oder mp4."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es una extensión: %@. Usa solo letras y números, como dmg o mp4."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas une extension : %@. Utilisez seulement des lettres et des chiffres, comme dmg ou mp4."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bukan ekstensi: %@. Gunakan huruf dan angka saja, seperti dmg atau mp4."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estensione non valida: %@. Usa solo lettere e cifre, ad esempio dmg o mp4."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡張子ではありません: %@。dmg や mp4 のように英数字だけを使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장자가 아닙니다: %@. dmg 또는 mp4처럼 영문자와 숫자만 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen extensie: %@. Gebruik alleen letters en cijfers, zoals dmg of mp4."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To nie jest rozszerzenie: %@. Używaj tylko liter i cyfr, np. dmg lub mp4."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é uma extensão: %@. Use só letras e números, como dmg ou mp4."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это не расширение: %@. Используйте только буквы и цифры, например dmg или mp4."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzantı değil: %@. dmg ya da mp4 gibi yalnızca harf ve rakam kullan."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це не розширення: %@. Використовуйте лише літери й цифри, наприклад dmg або mp4."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không phải phần mở rộng: %@. Chỉ dùng chữ cái và chữ số, chẳng hạn dmg hoặc mp4."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是扩展名：%@。只能使用字母和数字，例如 dmg 或 mp4。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不是副檔名：%@。只能使用字母和數字，例如 dmg 或 mp4。"
          }
        }
      }
    },
