    "Deleting a file from this folder also deletes its upload. Links to it stop working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Datei aus diesem Ordner löschst, wird auch ihr Upload gelöscht. Links darauf funktionieren dann nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar un archivo de esta carpeta también se elimina su subida. Los enlaces dejan de funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer un fichier de ce dossier supprime aussi son envoi. Les liens vers celui-ci cessent de fonctionner."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menghapus file dari folder ini juga menghapus unggahannya. Tautan ke file tersebut tidak akan berfungsi lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se elimini un file da questa cartella, viene eliminato anche il suo caricamento. I link al file smettono di funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダからファイルを削除すると、そのアップロードも削除されます。リンクは使えなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 폴더에서 파일을 삭제하면 해당 업로드도 삭제됩니다. 해당 파일의 링크는 더 이상 작동하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je een bestand uit deze map verwijdert, wordt ook de upload ervan verwijderd. Links ernaar werken dan niet meer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie pliku z tego folderu usuwa też jego przesłaną kopię. Linki do niej przestaną działać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir um arquivo desta pasta também exclui o envio dele. Os links para ele param de funcionar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При удалении файла из этой папки удаляется и его загрузка. Ссылки на него перестанут работать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu klasörden bir dosyayı silmek yüklemesini de siler. Ona giden bağlantılar çalışmaz olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо видалити файл із цієї папки, його вивантаження теж буде видалено. Посилання на нього перестануть працювати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa một tệp khỏi thư mục này cũng sẽ xóa tệp đã tải lên tương ứng. Các liên kết đến tệp đó sẽ ngừng hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从此文件夹删除文件时，也会删除其上传的文件。指向它的链接将失效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從此資料夾刪除檔案時，也會刪除其上傳的檔案。指向它的連結將會失效。"
          }
        }
      }
    },
