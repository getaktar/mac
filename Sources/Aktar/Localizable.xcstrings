          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wklej go w preferencjach rozszerzenia, jeśli nie używasz polecenia „Connect to Aktar”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
