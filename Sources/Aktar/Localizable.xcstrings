    "No account. No proprietary cloud. Your files stay yours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto. Keine proprietäre Cloud. Deine Dateien bleiben deine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta. Sin nube propietaria. Tus archivos siguen siendo tuyos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas de compte. Pas de cloud propriétaire. Vos fichiers restent à vous."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa akun. Tanpa cloud berpemilik. File Anda tetap milik Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account. Nessun cloud proprietario. I tuoi file restano tuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント不要。独自クラウドも不要。ファイルはあなたのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정도, 독점 클라우드도 필요 없습니다. 파일은 온전히 사용자의 것입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen account. Geen gesloten cloud. Je bestanden blijven van jou."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez konta. Bez zamkniętej chmury. Twoje pliki należą do Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta. Sem nuvem proprietária. Seus arquivos continuam seus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
