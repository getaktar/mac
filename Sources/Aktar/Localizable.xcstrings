    "A newer upload has the same name in the bucket, so only this history entry is removed. The file stays." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neuerer Upload hat denselben Namen im Bucket, daher wird nur dieser Verlaufseintrag entfernt. Die Datei bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
