    "A whole disk can't be watched. Pick a folder on it instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein ganzes Laufwerk kann nicht überwacht werden. Wähle stattdessen einen Ordner darauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede vigilar un disco entero. Elige una carpeta del disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un disque entier ne peut pas être surveillé. Choisissez plutôt un dossier sur ce disque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
