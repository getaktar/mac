    "Your files. Your storage. One shortcut away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Dateien. Dein Speicher. Nur einen Kurzbefehl entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus archivos. Tu almacenamiento. A un atajo de distancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos fichiers. Votre stockage. À un raccourci près."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルも、ストレージも、自分のもの。ショートカットひとつで。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus arquivos. Seu armazenamento. A um atalho de distância."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaların. Depolaman. Bir kısayol uzağında."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的文件，你的存储，一个快捷键搞定。"
          }
        }
      }
    },
    "Your home folder can't be watched. Pick a folder inside it, such as Desktop or Downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Benutzerordner kann nicht überwacht werden. Wähle einen Ordner darin, etwa Schreibtisch oder Downloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu carpeta de inicio no se puede vigilar. Elige una carpeta dentro de ella, como Escritorio o Descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dossier de départ ne peut pas être surveillé. Choisissez un dossier qu’il contient, comme Bureau ou Téléchargements."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームフォルダは監視できません。デスクトップやダウンロードなど、その中のフォルダを選んでください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua pasta pessoal não pode ser monitorada. Escolha uma pasta dentro dela, como Mesa ou Downloads."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana klasörün izlenemez. İçindeki bir klasörü seç, örneğin Masaüstü veya İndirilenler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法监视你的个人文件夹。请选择其中的文件夹，例如桌面或下载。"
          }
        }
      }
    },
    "Your recent uploads will appear here." : {
