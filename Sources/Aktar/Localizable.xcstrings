    "Your files. Your storage. One shortcut away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Dateien. Dein Speicher. Nur einen Kurzbefehl entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus archivos. Tu almacenamiento. A un atajo de distancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos fichiers. Votre stockage. À un raccourci près."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File Anda. Penyimpanan Anda. Cukup satu pintasan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi file. Il tuo spazio di archiviazione. A portata di abbreviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルも、ストレージも、自分のもの。ショートカットひとつで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나의 파일, 나의 저장 공간. 단축키 하나면 충분합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jouw bestanden. Jouw opslag. Met één toetscombinatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje pliki. Twój magazyn. Na jeden skrót."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus arquivos. Seu armazenamento. A um atalho de distância."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши файлы. Ваше хранилище. Одно сочетание клавиш."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaların. Depolaman. Bir kısayol uzağında."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваші файли. Ваше сховище. На відстані одного скорочення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp của bạn. Bộ nhớ lưu trữ của bạn. Chỉ cách một phím tắt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的文件，你的存储，一个快捷键搞定。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的檔案，你的儲存空間，一個快速鍵就搞定。"
          }
        }
      }
    },
    "Your home folder can't be watched. Pick a folder inside it, such as Desktop or Downloads." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Benutzerordner kann nicht überwacht werden. Wähle einen Ordner darin, etwa Schreibtisch oder Downloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu carpeta de inicio no se puede vigilar. Elige una carpeta dentro de ella, como Escritorio o Descargas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre dossier de départ ne peut pas être surveillé. Choisissez un dossier qu’il contient, comme Bureau ou Téléchargements."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder Rumah Anda tidak dapat dipantau. Pilih folder di dalamnya, seperti Desktop atau Unduhan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cartella Inizio non può essere monitorata. Scegli una cartella al suo interno, ad esempio Scrivania o Download."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームフォルダは監視できません。デスクトップやダウンロードなど、その中のフォルダを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "홈 폴더는 감시할 수 없습니다. 데스크탑이나 다운로드처럼 홈 폴더 안에 있는 폴더를 선택하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je thuismap kan niet worden bewaakt. Kies een map daarin, zoals Bureaublad of Downloads."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można obserwować folderu domowego. Wybierz folder w nim, np. Biurko lub Pobrane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua pasta pessoal não pode ser monitorada. Escolha uma pasta dentro dela, como Mesa ou Downloads."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нельзя отслеживать папку пользователя. Выберите папку внутри нее, например «Рабочий стол» или «Загрузки»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana klasörün izlenemez. İçindeki bir klasörü seç, örneğin Masaüstü veya İndirilenler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можна відстежувати домашню папку. Виберіть папку в ній, наприклад «Робочий стіл» або «Завантаження»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể theo dõi thư mục nhà. Hãy chọn một thư mục bên trong, chẳng hạn Màn hình nền hoặc Tải về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法监视你的个人文件夹。请选择其中的文件夹，例如桌面或下载。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法監看你的個人專屬資料夾。請選擇其中的資料夾，例如「桌面」或「下載項目」。"
          }
        }
      }
    },
    "Your recent uploads will appear here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine letzten Uploads werden hier angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus subidas recientes aparecerán aquí."
          }
        },
        "fr" : {
