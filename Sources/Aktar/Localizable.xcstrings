        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 단축기는 링크를 만료시킬 수 없으므로 임시 링크는 줄이지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
