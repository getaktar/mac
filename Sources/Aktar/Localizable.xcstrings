          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上传后"
          }
        }
      }
    },
    "Aktar asks before it deletes anything from the bucket." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar fragt, bevor es etwas aus dem Bucket löscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar pregunta antes de eliminar nada del bucket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar vous demande avant de supprimer quoi que ce soit du bucket."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktarはバケットから何かを削除する前に確認します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Aktar pergunta antes de excluir qualquer coisa do bucket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar, bucket'tan bir şey silmeden önce sorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar 会在从存储桶删除任何内容前询问。"
          }
        }
      }
    },
    "Aktar POSTs a JSON description of each upload to this address. Use https://, or http:// only for this Mac or your local network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar sendet für jeden Upload eine JSON-Beschreibung per POST an diese Adresse. Verwende https://, oder http:// nur für diesen Mac oder dein lokales Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar envía por POST una descripción JSON de cada subida a esta dirección. Usa https://, o http:// solo para este Mac o tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar envoie par POST une description JSON de chaque envoi à cette adresse. Utilisez https://, ou http:// seulement pour ce Mac ou votre réseau local."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktarは各アップロードのJSON説明をこのアドレスにPOSTします。https:// を使うか、http:// はこのMacかローカルネットワークの場合のみ使ってください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Aktar envia por POST uma descrição JSON de cada envio para este endereço. Use https://, ou http:// só para este Mac ou sua rede local."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar her yüklemenin JSON açıklamasını bu adrese POST eder. https:// kullan; http:// yalnızca bu Mac ya da yerel ağın için."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar 会将每次上传的 JSON 描述 POST 到此地址。请使用 https://，http:// 仅限这台 Mac 或你的局域网。"
          }
        }
      }
    },
    "Aktar's own folders can't be watched." : {
      "localizations" : {
        "de" : {
