    "Deleting a file from this folder also deletes its upload. Links to it stop working." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du eine Datei aus diesem Ordner löschst, wird auch ihr Upload gelöscht. Links darauf funktionieren dann nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar un archivo de esta carpeta también se elimina su subida. Los enlaces dejan de funcionar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer un fichier de ce dossier supprime aussi son envoi. Les liens vers celui-ci cessent de fonctionner."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダからファイルを削除すると、そのアップロードも削除されます。リンクは使えなくなります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir um arquivo desta pasta também exclui o envio dele. Os links para ele param de funcionar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
