    "Its deletion URL isn’t a simple request, so short links made with it can’t be deleted from Aktar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Lösch-URL ist keine einfache Anfrage, daher können damit erstellte Kurzlinks nicht in Aktar gelöscht werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su URL de eliminación no es una solicitud simple, así que los enlaces cortos creados con ella no se pueden eliminar desde Aktar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son URL de suppression n’est pas une requête simple : les liens courts créés avec elle ne peuvent pas être supprimés depuis Aktar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL hapusnya bukan permintaan sederhana, jadi tautan pendek yang dibuat dengannya tidak dapat dihapus dari Aktar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il suo URL di eliminazione non è una richiesta semplice, quindi i link brevi creati con essa non si possono eliminare da Aktar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "削除URLが単純なリクエストではないため、この構成で作成した短縮リンクはAktarから削除できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "삭제 URL이 단순한 요청이 아니므로 이 구성으로 만든 짧은 링크는 Aktar에서 삭제할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verwijder-URL is geen eenvoudig verzoek, dus korte links die ermee zijn gemaakt kunnen niet vanuit Aktar worden verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jej adres URL usuwania nie jest prostym żądaniem, więc krótkich linków utworzonych za jej pomocą nie można usunąć z Aktar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A URL de exclusão dela não é uma solicitação simples, então links curtos criados com ela não podem ser excluídos pelo Aktar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Её URL удаления не является простым запросом, поэтому созданные с ней короткие ссылки нельзя удалить из Aktar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Silme URL’si basit bir istek değil, bu yüzden onunla oluşturulan kısa bağlantılar Aktar’dan silinemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Її URL-адреса видалення не є простим запитом, тому створені з нею короткі посилання не можна видалити з Aktar."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "URL xóa của nó không phải là yêu cầu đơn giản, nên không thể xóa các liên kết ngắn tạo bằng nó từ Aktar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的删除网址不是简单请求，因此用它创建的短链接无法在 Aktar 中删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的刪除網址不是簡單請求，因此用它建立的短連結無法在 Aktar 中刪除。"
          }
        }
      }
    },
