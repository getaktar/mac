    "Listen on 127.0.0.1 so the Raycast extension can reach Aktar. Requests need the token below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf 127.0.0.1 lauschen, damit die Raycast-Erweiterung Aktar erreicht. Anfragen benötigen das Token unten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escucha en 127.0.0.1 para que la extensión de Raycast pueda comunicarse con Aktar. Las solicitudes necesitan el token de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écoute sur 127.0.0.1 pour que l’extension Raycast puisse joindre Aktar. Les requêtes nécessitent le jeton ci-dessous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raycast拡張機能がAktarに接続できるよう127.0.0.1で待ち受けます。リクエストには下のトークンが必要です。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escuta em 127.0.0.1 para que a extensão do Raycast alcance o Aktar. As solicitações precisam do token abaixo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raycast eklentisi Aktar'a ulaşabilsin diye 127.0.0.1'i dinler. İstekler aşağıdaki token'ı gerektirir."
