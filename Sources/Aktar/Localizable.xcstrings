    "Camera access is off. Turn it on in Settings, or paste the transfer link instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Kamerazugriff ist aus. Schalte ihn in den Einstellungen ein oder füge stattdessen den Übertragungslink ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la cámara está desactivado. Actívalo en Ajustes o pega el enlace de transferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la caméra est désactivé. Activez-le dans les Réglages, ou collez plutôt le lien de transfert."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akses kamera nonaktif. Nyalakan di Pengaturan, atau tempelkan tautan transfer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accesso alla fotocamera è disattivato. Attivalo in Impostazioni, oppure incolla il link di trasferimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カメラへのアクセスがオフです。設定でオンにするか、転送リンクを貼り付けてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라 접근이 꺼져 있습니다. 설정에서 켜거나 대신 전송 링크를 붙여넣으십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cameratoegang staat uit. Schakel deze in via Instellingen of plak in plaats daarvan de overdrachtslink."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do kamery jest wyłączony. Włącz go w Ustawieniach albo wklej link transferu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à câmera está desativado. Ative nos Ajustes ou cole o link de transferência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к камере выключен. Включите его в настройках или вставьте ссылку для переноса."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera erişimi kapalı. Ayarlar’dan aç ya da aktarım linkini yapıştır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ до камери вимкнено. Увімкніть його в Параметрах або вставте натомість посилання для перенесення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quyền truy cập camera đang tắt. Hãy bật trong Cài đặt, hoặc dán liên kết chuyển."
          }
        },
        "zh-Hans" : {
