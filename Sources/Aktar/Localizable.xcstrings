    "The Public Base URL didn’t serve the test file. Check the domain and that it points to this bucket." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die öffentliche Basis-URL hat die Testdatei nicht ausgeliefert. Prüfe die Domain und ob sie auf diesen Bucket zeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La URL base pública no sirvió el archivo de prueba. Comprueba el dominio y que apunte a este bucket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL de base publique n’a pas servi le fichier de test. Vérifiez le domaine et qu’il pointe vers ce bucket."
          }
        },
        "ja" : {
          "stringUnit" : {
