    "%@ was removed from %@. Delete it from the bucket too?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde aus %2$@ entfernt. Auch aus dem Bucket löschen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitó %1$@ de %2$@. ¿Eliminarlo también del bucket?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a été supprimé de %2$@. Le supprimer aussi du bucket ?"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dihapus dari %@. Hapus juga dari bucket?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è stato rimosso da %@. Eliminarlo anche dal bucket?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ が %2$@ から削除されました。バケットからも削除しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) %2$@에서 제거되었습니다. 버킷에서도 삭제하겠습니까?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is verwijderd uit %@. Ook uit de bucket verwijderen?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięto %1$@ z %2$@. Usunąć też z bucketu?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ foi removido de %2$@. Excluí-lo também do bucket?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл %@ удален из «%@». Удалить его также из бакета?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$@ klasöründen silindi. Bucket'tan da silinsin mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ видалено з %@. Видалити його й з бакета?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xóa %@ khỏi %@. Xóa cả khỏi bucket?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已从 %2$@ 中移除。也从存储桶中删除它吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已從 %2$@ 中移除。也要從儲存貯體刪除它嗎？"
          }
        }
      }
    },
