    "The remote file will be removed and its link may stop working. This can’t be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die entfernte Datei wird gelöscht und ihr Link funktioniert möglicherweise nicht mehr. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo remoto se eliminará y su enlace podría dejar de funcionar. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier distant sera supprimé et son lien risque de ne plus fonctionner. Cette action est irréversible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートファイルが削除され、リンクが機能しなくなる可能性があります。この操作は取り消せません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo remoto será apagado e o link pode parar de funcionar. Não é possível desfazer esta ação."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzak dosya silinecek ve bağlantısı çalışmayabilir. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "远程文件将被删除，其链接可能会失效。此操作无法撤销。"
          }
        }
      }
    },
