          "stringUnit" : {
            "state" : "translated",
            "value" : "端口必须是 1024 到 65535 之间的数字。"
          }
        }
      }
    },
    "The remote file will be removed and its link may stop working. This can’t be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die entfernte Datei wird gelöscht und ihr Link funktioniert möglicherweise nicht mehr. Dies kann nicht widerrufen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo remoto se eliminará y su enlace podría dejar de funcionar. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier distant sera supprimé et son lien risque de ne plus fonctionner. Cette action est irréversible."
