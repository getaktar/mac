    "Upload files and the clipboard, search your history, and browse your buckets without opening Aktar. Run “Connect to Aktar” in Raycast to pair it in one click." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Dateien und die Zwischenablage hoch, durchsuche deinen Verlauf und deine Buckets, ohne Aktar zu öffnen. Führe in Raycast „Connect to Aktar“ aus, um es mit einem Klick zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube archivos y el portapapeles, busca en tu historial y explora tus buckets sin abrir Aktar. Ejecuta «Connect to Aktar» en Raycast para vincularlo con un clic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des fichiers et le contenu du presse-papiers, recherchez dans votre historique et parcourez vos buckets sans ouvrir Aktar. Lancez « Connect to Aktar » dans Raycast pour l’associer en un clic."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktarを開かずに、ファイルやクリップボードのアップロード、履歴の検索、バケットの閲覧ができます。Raycastで「Connect to Aktar」を実行すると、ワンクリックで連携できます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie arquivos e a área de transferência, pesquise seu histórico e navegue pelos seus buckets sem abrir o Aktar. Execute “Connect to Aktar” no Raycast para conectar com um clique."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar'ı açmadan dosya ve pano yükle, geçmişinde ara, bucket'larına göz at. Tek tıkla eşleştirmek için Raycast'te “Connect to Aktar” komutunu çalıştır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需打开 Aktar 即可上传文件和剪贴板内容、搜索历史记录并浏览存储桶。在 Raycast 中运行“Connect to Aktar”即可一键配对。"
          }
        }
      }
    },
    "Upload files the moment they land in a folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Dateien hoch, sobald sie in einem Ordner landen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube archivos en cuanto llegan a una carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez les fichiers dès qu’ils arrivent dans un dossier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダにファイルが入った瞬間にアップロードします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
