    "Copy the public URL after an upload, or a temporary link that stops working after this long. Temporary links also work for private buckets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Upload die öffentliche URL kopieren oder einen temporären Link, der nach dieser Zeit nicht mehr funktioniert. Temporäre Links funktionieren auch bei privaten Buckets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la URL pública tras la subida, o un enlace temporal que deja de funcionar pasado este tiempo. Los enlaces temporales también funcionan con buckets privados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copier l’URL publique après l’envoi, ou un lien temporaire qui cesse de fonctionner après ce délai. Les liens temporaires fonctionnent aussi avec les buckets privés."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salin URL publik setelah unggahan, atau tautan sementara yang berhenti berfungsi setelah jangka waktu ini. Tautan sementara juga berfungsi untuk bucket pribadi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia l’URL pubblico dopo un caricamento, oppure un link temporaneo che smette di funzionare dopo questo tempo. I link temporanei funzionano anche con i bucket privati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロード後に公開URLをコピーするか、この時間が過ぎると使えなくなる期限付きリンクをコピーします。期限付きリンクは非公開のバケットでも使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "업로드 후 공개 URL을 복사하거나, 이 시간이 지나면 작동하지 않는 임시 링크를 복사합니다. 임시 링크는 비공개 버킷에서도 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer na een upload de openbare URL, of een tijdelijke link die na deze tijd niet meer werkt. Tijdelijke links werken ook voor privébuckets."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po przesłaniu kopiuj publiczny adres URL lub link tymczasowy, który przestaje działać po tym czasie. Linki tymczasowe działają też z prywatnymi bucketami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia a URL pública após o envio, ou um link temporário que para de funcionar depois desse tempo. Links temporários também funcionam com buckets privados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После загрузки копируется публичный URL или временная ссылка, которая перестает работать через указанное время. Временные ссылки работают и для приватных бакетов."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklemeden sonra genel URL'yi ya da bu süre dolunca çalışmayı bırakan süreli bir bağlantıyı kopyala. Süreli bağlantılar gizli bucket'larda da çalışır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після вивантаження копіюється публічна URL-адреса або тимчасове посилання, яке перестає працювати через вказаний час. Тимчасові посилання працюють і для приватних бакетів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sao chép URL công khai sau khi tải lên, hoặc một liên kết tạm thời sẽ ngừng hoạt động sau khoảng thời gian này. Liên kết tạm thời cũng dùng được với bucket riêng tư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上传后复制公开 URL，或复制一个在此时长后失效的临时链接。临时链接也适用于私有存储桶。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上傳後拷貝公開 URL，或拷貝在此時間後失效的暫時連結。暫時連結也適用於私人儲存貯體。"
          }
        }
      }
    },
