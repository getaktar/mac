    "The token isn’t stored. Aktar keeps only the storage keys made from it, in your Keychain." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Token wird nicht gespeichert. Aktar behält nur die daraus erzeugten Speicherschlüssel, in deinem Schlüsselbund."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El token no se guarda. Aktar solo conserva las claves de almacenamiento creadas a partir de él, en tu llavero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeton n’est pas conservé. Aktar ne garde que les clés de stockage créées à partir de celui-ci, dans votre trousseau."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token tidak disimpan. Aktar hanya menyimpan kunci penyimpanan yang dibuat darinya, di Rantai Kunci Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il token non viene salvato. Aktar conserva solo le chiavi di archiviazione create a partire da esso, nel tuo Portachiavi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "トークンは保存されません。Aktar が保持するのは、そこから作成されたストレージキーだけで、キーチェーンに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "토큰은 저장되지 않습니다. Aktar는 토큰으로 만든 스토리지 키만 키체인에 보관합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het token wordt niet opgeslagen. Aktar bewaart alleen de opslagsleutels die ermee zijn gemaakt, in je sleutelhanger."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token nie jest zapisywany. Aktar przechowuje w pęku kluczy tylko klucze magazynu utworzone na jego podstawie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O token não é armazenado. O Aktar guarda apenas as chaves de armazenamento criadas a partir dele, no seu Porta-Chaves."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токен не сохраняется. Aktar хранит только созданные с его помощью ключи хранилища, в вашей Связке ключей."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token saklanmaz. Aktar yalnızca bu token'dan üretilen depolama anahtarlarını Anahtar Zinciri'nde tutar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Токен не зберігається. Aktar зберігає лише створені з нього ключі сховища, у вашій Зв’язці ключів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token không được lưu. Aktar chỉ giữ lại các khóa lưu trữ được tạo từ token, trong Chuỗi khóa của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "令牌不会被保存。Aktar 只会把由它生成的存储密钥保存在你的钥匙串中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "權杖不會被儲存。Aktar 只會把由它產生的儲存金鑰保存在你的鑰匙圈中。"
          }
        }
      }
    },
