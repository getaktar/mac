    "A file is only moved once the bucket confirms the whole upload, and never deleted outright." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei wird erst verschoben, wenn der Bucket den ganzen Upload bestätigt, und nie endgültig gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un archivo solo se mueve cuando el bucket confirma la subida completa, y nunca se elimina directamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier n’est déplacé qu’une fois l’envoi entier confirmé par le bucket, et n’est jamais supprimé définitivement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File baru dipindahkan setelah bucket mengonfirmasi seluruh unggahan, dan tidak pernah langsung dihapus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file viene spostato solo dopo che il bucket ha confermato l’intero caricamento, e non viene mai eliminato definitivamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルはバケットがアップロード全体を確認してから移動され、直接削除されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일은 버킷이 전체 업로드를 확인한 후에만 이동되며, 바로 삭제되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een bestand wordt pas verplaatst als de bucket de volledige upload heeft bevestigd, en wordt nooit direct verwijderd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plik jest przenoszony dopiero wtedy, gdy bucket potwierdzi całe przesłanie, i nigdy nie jest od razu usuwany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um arquivo só é movido depois que o bucket confirma o envio completo, e nunca é excluído de vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл перемещается, только когда бакет подтвердит загрузку целиком, и никогда не удаляется безвозвратно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dosya ancak bucket yüklemenin tamamını doğruladıktan sonra taşınır ve asla doğrudan silinmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл переміщується, лише коли бакет підтвердить усе вивантаження, і ніколи не видаляється остаточно."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp chỉ được di chuyển khi bucket xác nhận đã nhận đủ toàn bộ nội dung tải lên, và không bao giờ bị xóa hẳn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在存储桶确认完整上传后才会移动文件，且绝不会直接删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有在儲存貯體確認整個上傳完成後才會搬移檔案，且絕不會直接刪除。"
          }
        }
      }
    },
