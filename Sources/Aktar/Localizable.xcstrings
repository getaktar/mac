        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リモートファイルが削除され、リンクが機能しなくなる可能性があります。この操作は取り消せません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
