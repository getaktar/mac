            "value" : "Aktar kann nur Dateien hochladen, keine Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar solo puede subir archivos, no carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar ne peut envoyer que des fichiers, pas des dossiers."
          }
        },
