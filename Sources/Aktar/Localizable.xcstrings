        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los archivos de la carpeta vuelven a contar como nuevos y se suben otra vez (si son más de 50 a la vez, se pregunta antes)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fichier du dossier redevient nouveau et est envoyé à nouveau (au-delà de 50 à la fois, une confirmation est demandée)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ内のすべてのファイルが再び新規扱いになり、もう一度アップロードされます（一度に50個を超える場合は先に確認します）。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os arquivos da pasta voltam a contar como novos e são enviados de novo (mais de 50 de uma vez pedem confirmação)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasördeki her dosya yeniden yeni sayılır ve bir kez daha yüklenir (aynı anda 50'den fazlası için önce sorulur)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件夹中的每个文件都会重新视为新文件并再次上传（一次超过 50 个时会先询问）。"
          }
        }
      }
    },
