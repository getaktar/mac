    "Couldn't remove the metadata from %@, so it wasn't uploaded. Set Image metadata to Keep all for this destination to upload it as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Metadaten von %@ konnten nicht entfernt werden, deshalb wurde die Datei nicht hochgeladen. Stelle Bild-Metadaten für dieses Ziel auf „Alle behalten“, um sie unverändert hochzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron quitar los metadatos de %@, así que no se subió. Pon Metadatos de imagen en Conservar todo en este destino para subirlo tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de supprimer les métadonnées de %@, le fichier n’a donc pas été envoyé. Réglez Métadonnées des images sur Tout conserver pour cette destination pour l’envoyer tel quel."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のメタデータを削除できなかったため、アップロードしませんでした。そのままアップロードするには、このアップロード先の画像のメタデータを「すべて残す」にしてください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível remover os metadados de %@, então o arquivo não foi enviado. Defina Metadados da imagem como Manter tudo neste destino para enviá-lo como está."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dosyasının meta verileri kaldırılamadı, bu yüzden yüklenmedi. Olduğu gibi yüklemek için bu hedefte Görsel meta verileri seçeneğini Tümünü koru yap."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法移除 %@ 的元数据，因此没有上传。要按原样上传，请将此上传目标的“图片元数据”设为“全部保留”。"
          }
        }
      }
    },
