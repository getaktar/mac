    "Files wait in their folders until your Mac is plugged in." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien warten in ihren Ordnern, bis dein Mac am Strom hängt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos esperan en sus carpetas hasta que conectes el Mac a la corriente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers attendent dans leurs dossiers jusqu’à ce que votre Mac soit branché."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File menunggu di foldernya hingga Mac Anda tersambung ke daya."
          }
        },
        "it" : {
          "stringUnit" : {
