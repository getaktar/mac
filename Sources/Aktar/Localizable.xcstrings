    "The imported settings upload to a different place than “%@” does now. Only update it if you trust where this link came from." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die importierten Einstellungen laden an einen anderen Ort hoch als „%@“ derzeit. Aktualisiere nur, wenn du der Herkunft dieses Links vertraust."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes importados suben a un lugar distinto del que usa “%@” ahora. Actualízalo solo si confías en el origen de este enlace."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages importés envoient les fichiers ailleurs que « %@ » actuellement. Ne mettez à jour que si vous faites confiance à la provenance de ce lien."
          }
        },
        "ja" : {
