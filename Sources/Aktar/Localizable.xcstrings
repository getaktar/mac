          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de prueba se subió, pero no está en la URL base pública. Comprueba que la URL apunte a este bucket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier de test a été envoyé, mais il n’est pas à l’URL de base publique. Vérifiez que l’URL pointe vers ce bucket."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File uji telah diunggah, tetapi tidak ada di URL Dasar Publik. Periksa apakah URL tersebut mengarah ke bucket ini."
          }
        },
        "it" : {
          "stringUnit" : {
