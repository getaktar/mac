    "Its target couldn’t be updated, so it may still point to the old location." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ziel konnte nicht aktualisiert werden, daher zeigt er vielleicht noch auf den alten Ort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo actualizar su destino, así que puede seguir apuntando a la ubicación anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa cible n’a pas pu être mise à jour : il peut encore pointer vers l’ancien emplacement."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Targetnya tidak dapat diperbarui, jadi mungkin masih mengarah ke lokasi lama."
