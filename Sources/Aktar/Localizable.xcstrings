    "Replace File" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Datei ersetzen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplazar archivo"
          }
        },
        "fr" : {
