    "No thumbnails are made or downloaded for this destination. History and the bucket view show file icons." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für dieses Ziel werden keine Vorschaubilder erstellt oder geladen. Verlauf und Bucket-Ansicht zeigen Dateisymbole."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se crean ni se descargan miniaturas para este destino. El historial y la vista del bucket muestran iconos de archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune vignette n’est créée ni téléchargée pour cette destination. L’historique et la vue du bucket affichent des icônes de fichier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この保存先ではサムネイルを作成もダウンロードもしません。履歴とバケット表示にはファイルアイコンが表示されます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhuma miniatura é criada ou baixada para este destino. O histórico e a visualização do bucket mostram ícones de arquivo."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hedef için küçük resim oluşturulmaz ve indirilmez. Geçmiş ve bucket görünümü dosya simgelerini gösterir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此目标不会创建或下载缩略图。历史记录和存储桶视图将显示文件图标。"
          }
        }
      }
    },
