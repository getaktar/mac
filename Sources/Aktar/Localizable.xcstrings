    "Auto-delete isn’t set up for this destination. Set it up from Aktar’s menu bar (Delete after) or the destination’s settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisches Löschen ist für dieses Ziel nicht eingerichtet. Richte es in Aktars Menüleiste (Löschen nach) oder in den Einstellungen des Ziels ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El borrado automático no está configurado para este destino. Configúralo desde la barra de menús de Aktar (Eliminar tras) o en los ajustes del destino."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression automatique n’est pas configurée pour cette destination. Configurez-la depuis la barre des menus d’Aktar (Supprimer après) ou les réglages de la destination."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus otomatis belum diatur untuk tujuan ini. Atur dari bar menu Aktar (Hapus setelah) atau dari pengaturan tujuan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’eliminazione automatica non è configurata per questa destinazione. Configurala dalla barra dei menu di Aktar (Elimina dopo) o dalle impostazioni della destinazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアップロード先では自動削除が設定されていません。Aktar のメニューバー (削除まで) またはアップロード先の設定で設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 대상에는 자동 삭제가 설정되어 있지 않습니다. Aktar의 메뉴 막대(보관 기간) 또는 대상 설정에서 설정하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatisch verwijderen is niet ingesteld voor deze bestemming. Stel het in via de menubalk van Aktar (Verwijder na) of de instellingen van de bestemming."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatyczne usuwanie nie jest skonfigurowane dla tego miejsca docelowego. Skonfiguruj je na pasku menu Aktara (Usuń po) lub w ustawieniach miejsca docelowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exclusão automática não está configurada para este destino. Configure-a na barra de menus do Aktar (Excluir após) ou nos ajustes do destino."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автоудаление не настроено для этого места назначения. Настройте его в строке меню Aktar («Удалить через») или в настройках места назначения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu hedef için otomatik silme ayarlı değil. Aktar'ın menü çubuğundan (Silinme) ya da hedefin ayarlarından ayarla."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Автовидалення не налаштовано для цієї цілі. Налаштуйте його в смузі меню Aktar («Видалити через») або в параметрах цілі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tự động xóa chưa được thiết lập cho đích này. Hãy thiết lập từ thanh menu của Aktar (Xóa sau) hoặc trong cài đặt của đích."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此目标尚未设置自动删除。请在 Aktar 菜单栏（删除时间）或目标设置中进行设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此目的地尚未設定自動刪除。請從 Aktar 的選單列（刪除時間）或目的地的設定中設定。"
          }
        }
      }
    },
