    "When a file you already uploaded to the same destination comes up again, Aktar copies its existing link instead of uploading it again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn eine Datei, die du schon zum selben Ziel hochgeladen hast, erneut kommt, kopiert Aktar ihren vorhandenen Link, statt sie noch einmal hochzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando vuelve a aparecer un archivo que ya subiste al mismo destino, Aktar copia su enlace existente en lugar de subirlo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsqu’un fichier déjà envoyé vers la même destination revient, Aktar copie son lien existant au lieu de l’envoyer à nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じアップロード先にアップロード済みのファイルがもう一度来たときは、再度アップロードせずに既存のリンクをコピーします。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando um arquivo que você já enviou para o mesmo destino aparece de novo, o Aktar copia o link existente em vez de enviá-lo outra vez."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı hedefe daha önce yüklediğin bir dosya tekrar geldiğinde Aktar, onu yeniden yüklemek yerine mevcut bağlantısını kopyalar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你已上传到同一目标的文件再次出现时，Aktar 会复制它现有的链接，而不是再次上传。"
          }
        }
      }
    },
    "Works even when the panel is closed. Click to record, or press Delete to clear it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funktioniert auch bei geschlossenem Panel. Zum Aufnehmen klicken, zum Löschen die Rückschritttaste drücken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona incluso con el panel cerrado. Haz clic para grabarlo o pulsa Eliminar para borrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne même lorsque le panneau est fermé. Cliquez pour enregistrer, ou appuyez sur Supprimer pour l’effacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "パネルを閉じていても使えます。クリックして記録、deleteキーで消去します。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona mesmo com o painel fechado. Clique para gravar ou pressione Apagar para limpar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Panel kapalıyken bile çalışır. Kaydetmek için tıkla, temizlemek için Sil tuşuna bas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使面板关闭也能使用。点按以录制，或按删除键清除。"
          }
        }
      }
    },
