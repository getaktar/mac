    "Name the rules aktar-expire-1d, aktar-expire-7d, aktar-expire-14d, and aktar-expire-30d, or Aktar won't recognize them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benenne die Regeln aktar-expire-1d, aktar-expire-7d, aktar-expire-14d und aktar-expire-30d, sonst erkennt Aktar sie nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombra las reglas aktar-expire-1d, aktar-expire-7d, aktar-expire-14d y aktar-expire-30d, o Aktar no las reconocerá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nommez les règles aktar-expire-1d, aktar-expire-7d, aktar-expire-14d et aktar-expire-30d, sinon Aktar ne les reconnaîtra pas."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beri nama aturan aktar-expire-1d, aktar-expire-7d, aktar-expire-14d, dan aktar-expire-30d, atau Aktar tidak akan mengenalinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiama le regole aktar-expire-1d, aktar-expire-7d, aktar-expire-14d e aktar-expire-30d, altrimenti Aktar non le riconoscerà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルール名は aktar-expire-1d、aktar-expire-7d、aktar-expire-14d、aktar-expire-30d にしてください。それ以外の名前では Aktar が認識しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "규칙 이름을 aktar-expire-1d, aktar-expire-7d, aktar-expire-14d, aktar-expire-30d로 지정하십시오. 그렇지 않으면 Aktar가 인식하지 못합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noem de regels aktar-expire-1d, aktar-expire-7d, aktar-expire-14d en aktar-expire-30d, anders herkent Aktar ze niet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nazwij reguły aktar-expire-1d, aktar-expire-7d, aktar-expire-14d i aktar-expire-30d, w przeciwnym razie Aktar ich nie rozpozna."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomeie as regras aktar-expire-1d, aktar-expire-7d, aktar-expire-14d e aktar-expire-30d, ou o Aktar não as reconhecerá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назовите правила aktar-expire-1d, aktar-expire-7d, aktar-expire-14d и aktar-expire-30d, иначе Aktar их не распознает."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuralları aktar-expire-1d, aktar-expire-7d, aktar-expire-14d ve aktar-expire-30d olarak adlandırın; aksi halde Aktar onları tanımaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назвіть правила aktar-expire-1d, aktar-expire-7d, aktar-expire-14d і aktar-expire-30d, інакше Aktar їх не розпізнає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đặt tên các quy tắc là aktar-expire-1d, aktar-expire-7d, aktar-expire-14d và aktar-expire-30d, nếu không Aktar sẽ không nhận ra chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将规则命名为 aktar-expire-1d、aktar-expire-7d、aktar-expire-14d 和 aktar-expire-30d，否则 Aktar 无法识别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請將規則命名為 aktar-expire-1d、aktar-expire-7d、aktar-expire-14d 和 aktar-expire-30d，否則 Aktar 無法辨識。"
          }
        }
      }
    },
