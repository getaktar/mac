    "Copy the public URL after an upload, or a temporary link that stops working after this long. Temporary links also work for private buckets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Upload die öffentliche URL kopieren oder einen temporären Link, der nach dieser Zeit nicht mehr funktioniert. Temporäre Links funktionieren auch bei privaten Buckets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia la URL pública tras la subida, o un enlace temporal que deja de funcionar pasado este tiempo. Los enlaces temporales también funcionan con buckets privados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copier l’URL publique après l’envoi, ou un lien temporaire qui cesse de fonctionner après ce délai. Les liens temporaires fonctionnent aussi avec les buckets privés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップロード後に公開URLをコピーするか、この時間が過ぎると使えなくなる期限付きリンクをコピーします。期限付きリンクは非公開のバケットでも使えます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia a URL pública após o envio, ou um link temporário que para de funcionar depois desse tempo. Links temporários também funcionam com buckets privados."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklemeden sonra genel URL'yi ya da bu süre dolunca çalışmayı bırakan süreli bir bağlantıyı kopyala. Süreli bağlantılar gizli bucket'larda da çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上传后复制公开 URL，或复制一个在此时长后失效的临时链接。临时链接也适用于私有存储桶。"
          }
        }
      }
    },
