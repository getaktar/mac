    "Every file in the folder counts as new again, and is uploaded once more (more than 50 at once ask first)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Datei im Ordner gilt wieder als neu und wird erneut hochgeladen (bei mehr als 50 auf einmal wird vorher gefragt)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los archivos de la carpeta vuelven a contar como nuevos y se suben otra vez (si son más de 50 a la vez, se pregunta antes)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fichier du dossier redevient nouveau et est envoyé à nouveau (au-delà de 50 à la fois, une confirmation est demandée)."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setiap file di folder dianggap baru lagi dan diunggah sekali lagi (jika lebih dari 50 sekaligus, Anda akan ditanya dulu)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni file nella cartella torna a essere considerato nuovo e viene caricato di nuovo (se sono più di 50 alla volta, viene chiesta conferma)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダ内のすべてのファイルが再び新規扱いになり、もう一度アップロードされます（一度に50個を超える場合は先に確認します）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더의 모든 파일이 다시 새 파일로 간주되어 한 번 더 업로드됩니다(한 번에 50개를 초과하면 먼저 확인합니다)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk bestand in de map telt weer als nieuw en wordt opnieuw geüpload (bij meer dan 50 tegelijk wordt het eerst gevraagd)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy plik w folderze znów jest traktowany jako nowy i zostanie przesłany ponownie (przy ponad 50 plikach naraz Aktar najpierw zapyta)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os arquivos da pasta voltam a contar como novos e são enviados de novo (mais de 50 de uma vez pedem confirmação)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый файл в папке снова считается новым и загружается еще раз (если файлов больше 50, сначала появится запрос)."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasördeki her dosya yeniden yeni sayılır ve bir kez daha yüklenir (aynı anda 50'den fazlası için önce sorulur)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен файл у папці знову вважатиметься новим і буде вивантажений ще раз (якщо їх понад 50, Aktar спершу запитає)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi tệp trong thư mục sẽ được coi là mới và được tải lên lại (nếu có hơn 50 tệp cùng lúc, Aktar sẽ hỏi trước)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文件夹中的每个文件都会重新视为新文件并再次上传（一次超过 50 个时会先询问）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "資料夾中的每個檔案都會再次視為新檔案並重新上傳（一次超過 50 個時會先詢問）。"
          }
        }
      }
    },
