        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar가 아직 준비되지 않았습니다. 잠시 후 다시 시도하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar is nog niet klaar. Probeer het zo opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar nie jest jeszcze gotowy. Spróbuj ponownie za chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Aktar ainda não está pronto. Tente de novo daqui a pouco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar еще не готов. Повторите попытку чуть позже."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar henüz hazır değil. Biraz sonra yeniden dene."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar ще не готовий. Спробуйте ще раз за мить."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar chưa sẵn sàng. Hãy thử lại sau giây lát."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar 尚未准备好，请稍后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar 尚未就緒，請稍後再試一次。"
          }
        }
      }
    },
    "Aktar POSTs a JSON description of each upload to this address. Use https://, or http:// only for this Mac or your local network." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar sendet für jeden Upload eine JSON-Beschreibung per POST an diese Adresse. Verwende https://, oder http:// nur für diesen Mac oder dein lokales Netzwerk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar envía por POST una descripción JSON de cada subida a esta dirección. Usa https://, o http:// solo para este Mac o tu red local."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar envoie par POST une description JSON de chaque envoi à cette adresse. Utilisez https://, ou http:// seulement pour ce Mac ou votre réseau local."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar mengirim deskripsi JSON setiap unggahan ke alamat ini melalui POST. Gunakan https://, atau http:// hanya untuk Mac ini atau jaringan lokal Anda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar invia tramite POST una descrizione JSON di ogni caricamento a questo indirizzo. Usa https://, oppure http:// solo per questo Mac o la tua rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktarは各アップロードのJSON説明をこのアドレスにPOSTします。https:// を使うか、http:// はこのMacかローカルネットワークの場合のみ使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar는 각 업로드에 대한 JSON 설명을 이 주소로 POST합니다. https://를 사용하거나, http://는 이 Mac 또는 로컬 네트워크에서만 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar stuurt voor elke upload een JSON-beschrijving via POST naar dit adres. Gebruik https://, of http:// alleen voor deze Mac of je lokale netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar wysyła na ten adres żądanie POST z opisem każdego przesłanego pliku w formacie JSON. Użyj https:// albo http:// tylko dla tego Maca lub sieci lokalnej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Aktar envia por POST uma descrição JSON de cada envio para este endereço. Use https://, ou http:// só para este Mac ou sua rede local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar отправляет на этот адрес POST-запрос с JSON-описанием каждой загрузки. Используйте https://, а http:// только для этого Mac или локальной сети."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar her yüklemenin JSON açıklamasını bu adrese POST eder. https:// kullan; http:// yalnızca bu Mac ya da yerel ağın için."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar надсилає POST-запит з описом кожного вивантаження у форматі JSON на цю адресу. Використовуйте https://, а http:// лише для цього Mac або вашої локальної мережі."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar gửi yêu cầu POST chứa mô tả JSON của mỗi tệp tải lên đến địa chỉ này. Hãy dùng https://, hoặc http:// chỉ cho máy Mac này hoặc mạng cục bộ của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar 会将每次上传的 JSON 描述 POST 到此地址。请使用 https://，http:// 仅限这台 Mac 或你的局域网。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar 會將每次上傳的 JSON 描述以 POST 傳送到此位址。請使用 https://，http:// 僅限用於這台 Mac 或你的區域網路。"
          }
        }
      }
    },
