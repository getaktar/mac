          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 上的缩略图"
          }
        }
      }
    },
    "Thumbnails saved in %@ stay in the bucket unless you delete them. Your files aren’t affected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@ gespeicherte Vorschaubilder bleiben im Bucket, bis du sie löschst. Deine Dateien sind nicht betroffen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las miniaturas guardadas en %@ se quedan en el bucket a menos que las elimines. Tus archivos no se ven afectados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les vignettes enregistrées dans %@ restent dans le bucket tant que vous ne les supprimez pas. Vos fichiers ne sont pas concernés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に保存されたサムネイルは、削除しない限りバケットに残ります。ファイル自体には影響しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As miniaturas salvas em %@ continuam no bucket, a menos que você as apague. Seus arquivos não são afetados."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ içine kaydedilen küçük resimler, sen silmedikçe bucket'ta kalır. Dosyaların etkilenmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存在 %@ 中的缩略图会保留在存储桶中，除非你删除它们。你的文件不受影响。"
          }
        }
      }
    },
    "“%@” and its files stay where they are, and uploads stay in the bucket." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und seine Dateien bleiben, wo sie sind, und Uploads bleiben im Bucket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» y sus archivos se quedan donde están, y las subidas siguen en el bucket."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et ses fichiers restent où ils sont, et les envois restent dans le bucket."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」とそのファイルはそのまま残り、アップロード済みのファイルもバケットに残ります。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” e seus arquivos ficam onde estão, e os envios continuam no bucket."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” ve dosyaları oldukları yerde kalır, yüklemeler de bucket'ta kalır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”及其文件会保留在原处，已上传的文件也会保留在存储桶中。"
          }
        }
      }
    },
