    "Couldn't remove the metadata from %@, so it wasn't uploaded. Set Image metadata to Keep all for this destination to upload it as it is." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Metadaten von %@ konnten nicht entfernt werden, deshalb wurde die Datei nicht hochgeladen. Stelle Bild-Metadaten für dieses Ziel auf „Alle behalten“, um sie unverändert hochzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron quitar los metadatos de %@, así que no se subió. Pon Metadatos de imagen en Conservar todo en este destino para subirlo tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de supprimer les métadonnées de %@, le fichier n’a donc pas été envoyé. Réglez Métadonnées des images sur Tout conserver pour cette destination pour l’envoyer tel quel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat menghapus metadata dari %@, sehingga file tidak diunggah. Atur Metadata gambar ke Pertahankan semua untuk tujuan ini agar file diunggah apa adanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile rimuovere i metadati da %@, quindi non è stato caricato. Imposta “Metadati immagine” su “Mantieni tutto” per questa destinazione per caricarlo così com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のメタデータを削除できなかったため、アップロードしませんでした。そのままアップロードするには、このアップロード先の画像のメタデータを「すべて残す」にしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 메타데이터를 제거할 수 없어 업로드하지 않았습니다. 그대로 업로드하려면 이 대상의 이미지 메타데이터를 ‘모두 유지’로 설정하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan de metadata niet uit %@ verwijderen, dus het bestand is niet geüpload. Stel ‘Afbeeldingsmetadata’ voor deze bestemming in op ‘Behoud alles’ om het ongewijzigd te uploaden."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można usunąć metadanych z %@, więc plik nie został przesłany. Aby przesłać go bez zmian, ustaw dla tego miejsca docelowego opcję Metadane obrazów na „Zachowaj wszystkie”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível remover os metadados de %@, então o arquivo não foi enviado. Defina Metadados da imagem como Manter tudo neste destino para enviá-lo como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось удалить метаданные из %@, поэтому файл не загружен. Чтобы загрузить его без изменений, выберите «Сохранить все» в параметре «Метаданные изображений» для этого места назначения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ dosyasının meta verileri kaldırılamadı, bu yüzden yüklenmedi. Olduğu gibi yüklemek için bu hedefte Görsel meta verileri seçeneğini Tümünü koru yap."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося вилучити метадані з %@, тому файл не вивантажено. Щоб вивантажити його без змін, установіть для цієї цілі «Метадані зображень» на «Зберегти всі»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xóa siêu dữ liệu khỏi %@, nên tệp chưa được tải lên. Đặt Siêu dữ liệu hình ảnh thành Giữ tất cả cho đích này để tải lên nguyên trạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法移除 %@ 的元数据，因此没有上传。要按原样上传，请将此上传目标的“图片元数据”设为“全部保留”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法移除 %@ 的後設資料，因此未上傳。若要按原樣上傳，請將此目的地的「影像後設資料」設為「全部保留」。"
          }
        }
      }
    },
