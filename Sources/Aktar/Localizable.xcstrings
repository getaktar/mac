      }
    },
    "Upload files to your own storage, then instantly copy a shareable URL." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade Dateien in deinen eigenen Speicher hoch und kopiere sofort eine teilbare URL."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sube archivos a tu propio almacenamiento y copia al instante una URL para compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyez des fichiers vers votre propre stockage, puis copiez instantanément une URL à partager."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分のストレージにファイルをアップロードして、共有用URLをすぐにコピーできます。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envie arquivos para seu próprio armazenamento e copie na hora uma URL para compartilhar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları kendi depolama alanına yükle, paylaşılabilir bağlantıyı anında kopyala."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将文件上传到你自己的存储，并立即复制可分享的 URL。"
          }
        }
      }
    },
