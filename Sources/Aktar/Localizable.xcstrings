    "No domain on this Cloudflare account. Add one to Cloudflare first, or use the r2.dev address." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Cloudflare-Konto hat keine Domain. Füge zuerst eine bei Cloudflare hinzu oder nutze die r2.dev-Adresse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta cuenta de Cloudflare no tiene ningún dominio. Añade uno a Cloudflare primero, o usa la dirección r2.dev."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun domaine sur ce compte Cloudflare. Ajoutez-en un à Cloudflare d’abord, ou utilisez l’adresse r2.dev."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada domain di akun Cloudflare ini. Tambahkan satu ke Cloudflare terlebih dahulu, atau gunakan alamat r2.dev."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun dominio in questo account Cloudflare. Aggiungine prima uno a Cloudflare, oppure usa l’indirizzo r2.dev."
