          }
        }
      }
    },
    "This shortener can’t expire links, so temporary links aren’t shortened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Linkkürzer kann Links nicht ablaufen lassen, daher werden temporäre Links nicht gekürzt."
