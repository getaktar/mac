    "{short} makes links shorter, not private. For private sharing, keep the bucket private and copy temporary links." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} macht Links kürzer, nicht privat. Für privates Teilen lass den Bucket privat und kopiere temporäre Links."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} hace los enlaces más cortos, no privados. Para compartir en privado, mantén el bucket privado y copia enlaces temporales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} raccourcit les liens, sans les rendre privés. Pour partager en privé, gardez le bucket privé et copiez des liens temporaires."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} membuat tautan lebih pendek, bukan pribadi. Untuk berbagi secara pribadi, biarkan bucket tetap pribadi dan salin tautan sementara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} rende i link più brevi, non privati. Per condividere in privato, mantieni il bucket privato e copia link temporanei."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} はリンクを短くしますが、非公開にはしません。非公開で共有するには、バケットを非公開のままにして期限付きリンクをコピーしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short}는 링크를 짧게 만들 뿐 비공개로 만들지 않습니다. 비공개로 공유하려면 버킷을 비공개로 유지하고 임시 링크를 복사하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} maakt links korter, niet privé. Om privé te delen houd je de bucket privé en kopieer je tijdelijke links."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} skraca linki, ale nie czyni ich prywatnymi. Aby udostępniać prywatnie, pozostaw bucket prywatny i kopiuj linki tymczasowe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} deixa os links mais curtos, não privados. Para compartilhar de forma privada, mantenha o bucket privado e copie links temporários."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} делает ссылки короче, но не приватными. Чтобы делиться приватно, оставьте бакет приватным и копируйте временные ссылки."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} bağlantıları kısaltır, gizli yapmaz. Gizli paylaşım için bucket'ı gizli tut ve süreli bağlantıları kopyala."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} робить посилання коротшими, але не приватними. Щоб ділитися приватно, залиште бакет приватним і копіюйте тимчасові посилання."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} làm liên kết ngắn hơn, không làm chúng riêng tư. Để chia sẻ riêng tư, hãy giữ bucket ở chế độ riêng tư và sao chép liên kết tạm thời."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} 只会让链接更短，不会让它们变得私密。如需私密分享，请保持存储桶私有并复制临时链接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "{short} 只會讓連結更短，不會讓它們變得私密。如需私密分享，請保持儲存貯體私人並拷貝暫時連結。"
          }
        }
      }
    },
    "“%@” and its files stay where they are, and uploads stay in the bucket." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
