    "%@ already hold files. Once the rules are set up, the bucket deletes them too when they're older than the folder's number of days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@ liegen schon Dateien. Sobald die Regeln eingerichtet sind, löscht der Bucket auch diese, wenn sie älter als die Tage des Ordners sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ya contienen archivos. Una vez configuradas las reglas, el bucket también los eliminará cuando superen los días de la carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ contiennent déjà des fichiers. Une fois les règles en place, le bucket les supprime aussi lorsqu'ils dépassent le nombre de jours du dossier."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sudah berisi file. Setelah aturan diatur, bucket juga menghapusnya jika usianya melebihi jumlah hari folder tersebut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ contengono già dei file. Una volta configurate le regole, il bucket elimina anche quelli più vecchi del numero di giorni della cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ にはすでにファイルがあります。ルールを設定すると、フォルダの日数より古いファイルもバケットが削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 이미 파일이 있습니다. 규칙이 설정되면 폴더에 지정된 일수보다 오래된 파일도 버킷이 삭제합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@ staan al bestanden. Zodra de regels zijn ingesteld, verwijdert de bucket die ook als ze ouder zijn dan het aantal dagen van de map."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W %@ są już pliki. Po skonfigurowaniu reguł bucket usunie także je, gdy będą starsze niż liczba dni danego folderu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ já contêm arquivos. Depois que as regras forem configuradas, o bucket também os apagará quando passarem do número de dias da pasta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В %@ уже есть файлы. После настройки правил бакет будет удалять и их, когда они станут старше срока папки в днях."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ içinde zaten dosyalar var. Kurallar kurulunca bucket, klasörün gün sayısından eski olan bu dosyaları da siler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У %@ уже є файли. Після налаштування правил бакет видалятиме й їх, коли їхній вік перевищить кількість днів, задану для папки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đã chứa tệp. Khi các quy tắc được thiết lập, bucket cũng sẽ xóa các tệp đó khi chúng cũ hơn số ngày của thư mục."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中已有文件。规则设置后，存储桶也会删除其中超过该文件夹天数的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 中已有檔案。規則設定完成後，儲存貯體也會刪除其中超過該資料夾天數的檔案。"
          }
        }
      }
    },
