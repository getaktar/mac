    "Scan this QR code with Aktar on your other device, then enter the transfer code there." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scanne diesen QR-Code mit Aktar auf deinem anderen Gerät und gib dort den Übertragungscode ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escanea este código QR con Aktar en tu otro dispositivo y luego introduce allí el código de transferencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scannez ce code QR avec Aktar sur votre autre appareil, puis saisissez-y le code de transfert."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方のデバイスのAktarでこのQRコードを読み取り、そこで転送コードを入力してください。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escaneie este QR code com o Aktar no seu outro dispositivo e depois digite o código de transferência lá."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu QR kodu diğer cihazındaki Aktar ile tara, sonra aktarım kodunu orada gir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用另一台设备上的 Aktar 扫描此二维码，然后在那里输入传输码。"
          }
        }
      }
    },
