        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar solo puede leer el enlace corto como un valor de una respuesta JSON, como {json:link}."
          }
        },
        "fr" : {
          "stringUnit" : {
