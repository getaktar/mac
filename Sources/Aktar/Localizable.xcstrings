    "Either way, files added from now on are uploaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So oder so werden ab jetzt hinzugefügte Dateien hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cualquier caso, los archivos que se añadan a partir de ahora se suben."
