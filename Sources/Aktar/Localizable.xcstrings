          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адрес сервиса сокращения ссылок использует http://. Включите «Разрешить небезопасный HTTP», чтобы всё равно его использовать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlantı kısaltıcının adresi http:// kullanıyor. Yine de kullanmak için “Güvenli olmayan HTTP’ye izin ver”i açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адреса сервісу скорочення посилань використовує http://. Увімкніть «Дозволити незахищений HTTP», щоб усе одно її використати."
          }
        },
        "vi" : {
          "stringUnit" : {
