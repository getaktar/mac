    "A bucket with this name already exists. Pick it from the list above to use it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Bucket mit diesem Namen existiert bereits. Wähle ihn oben aus der Liste aus, um ihn zu verwenden."
