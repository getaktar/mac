    "The link shortener’s address uses http://. Turn on “Allow insecure HTTP” to use it anyway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Adresse des Linkkürzers verwendet http://. Schalte „Unsicheres HTTP erlauben“ ein, um sie trotzdem zu nutzen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La dirección del acortador usa http://. Activa “Permitir HTTP no seguro” para usarla de todos modos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’adresse du raccourcisseur utilise http://. Activez « Autoriser le HTTP non sécurisé » pour l’utiliser quand même."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alamat pemendek tautan memakai http://. Aktifkan “Izinkan HTTP tidak aman” untuk tetap memakainya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’indirizzo dell’accorciatore usa http://. Attiva “Consenti HTTP non sicuro” per usarlo comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短縮サービスのアドレスは http:// です。それでも使うには「安全でないHTTPを許可」をオンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "링크 단축기의 주소가 http://를 사용합니다. 그래도 사용하려면 ‘안전하지 않은 HTTP 허용’을 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het adres van de linkverkorter gebruikt http://. Zet ‘Onveilige HTTP toestaan’ aan om het toch te gebruiken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adres skracacza linków używa http://. Włącz „Zezwalaj na niezabezpieczony HTTP”, aby mimo to go użyć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
