        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片、影片、PDF 和文件的縮圖會在這台 Mac 上製作，且只保留在這裡。儲存貯體中既有的檔案若小於 25 MB，會在顯示時製作縮圖。"
          }
        }
      }
    },
