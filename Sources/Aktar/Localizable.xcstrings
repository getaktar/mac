          "stringUnit" : {
            "state" : "translated",
            "value" : "Benenne die Regeln aktar-expire-1d, aktar-expire-7d, aktar-expire-14d und aktar-expire-30d, sonst erkennt Aktar sie nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombra las reglas aktar-expire-1d, aktar-expire-7d, aktar-expire-14d y aktar-expire-30d, o Aktar no las reconocerá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nommez les règles aktar-expire-1d, aktar-expire-7d, aktar-expire-14d et aktar-expire-30d, sinon Aktar ne les reconnaîtra pas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルール名は aktar-expire-1d、aktar-expire-7d、aktar-expire-14d、aktar-expire-30d にしてください。それ以外の名前では Aktar が認識しません。"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nomeie as regras aktar-expire-1d, aktar-expire-7d, aktar-expire-14d e aktar-expire-30d, ou o Aktar não as reconhecerá."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kuralları aktar-expire-1d, aktar-expire-7d, aktar-expire-14d ve aktar-expire-30d olarak adlandırın; aksi halde Aktar onları tanımaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将规则命名为 aktar-expire-1d、aktar-expire-7d、aktar-expire-14d 和 aktar-expire-30d，否则 Aktar 无法识别。"
          }
        }
      }
    },
