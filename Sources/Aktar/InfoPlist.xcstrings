      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar verwendet die Kamera, um den QR-Code eines Ziels zu scannen, das du von deinem anderen Gerät teilst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar uses the camera to scan the QR code of a destination shared from your other device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar usa la cámara para escanear el código QR de un destino compartido desde tu otro dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktar utilise la caméra pour scanner le code QR d’une destination partagée depuis votre autre appareil."
